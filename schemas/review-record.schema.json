{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wzf1997/delivery-harness/main/schemas/review-record.schema.json",
  "title": "DeliveryGuard review-record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidate",
    "checks",
    "decisions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "repositoryId",
        "task",
        "author",
        "branch",
        "commit",
        "tree",
        "environmentId",
        "mode",
        "files",
        "sensitiveFindings",
        "baseCommit"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "repositoryId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision",
            "kind",
            "changesRules",
            "documentRevision",
            "summary",
            "acceptanceCriteria"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "kind": {
              "enum": [
                "feature",
                "bug"
              ]
            },
            "changesRules": {
              "type": "boolean"
            },
            "documentRevision": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "acceptanceCriteria": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "tree": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "environmentId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "mode": {
          "enum": [
            "delivery",
            "hotfix",
            "integration"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "changedLines"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.@-]+(?:/[A-Za-z0-9_.@-]+)*$"
              },
              "changedLines": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "minItems": 1
        },
        "sensitiveFindings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        },
        "integration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targetBranch",
            "parents",
            "targetHead",
            "sourceHead",
            "conflictPaths",
            "resolutionPaths",
            "observedAt",
            "evidence"
          ],
          "properties": {
            "targetBranch": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "parents": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                },
                {
                  "type": "string",
                  "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "targetHead": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "sourceHead": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "conflictPaths": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.@-]+(?:/[A-Za-z0-9_.@-]+)*$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "resolutionPaths": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.@-]+(?:/[A-Za-z0-9_.@-]+)*$"
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            },
            "evidence": {
              "type": "string",
              "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.@-]+(?:/[A-Za-z0-9_.@-]+)*$"
            }
          }
        },
        "baseCommit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "candidateDigest",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "candidateDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "evidence": {
            "type": "string",
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.@-]+(?:/[A-Za-z0-9_.@-]+)*$"
          }
        }
      },
      "minItems": 0
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "outcome",
          "reviewer",
          "candidateDigest",
          "policyDigest",
          "recordedAt",
          "expiresAt",
          "evidence"
        ],
        "properties": {
          "kind": {
            "enum": [
              "human",
              "automatic"
            ]
          },
          "outcome": {
            "enum": [
              "approved",
              "rejected"
            ]
          },
          "reviewer": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "candidateDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "policyDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "evidence": {
            "type": "string",
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.@-]+(?:/[A-Za-z0-9_.@-]+)*$"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "suitability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "risk": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "minItems": 0
    }
  }
}
