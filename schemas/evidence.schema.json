{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wzf1997/delivery-harness/main/schemas/evidence.schema.json",
  "title": "DeliveryGuard evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "documents", "requirements", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["documentId", "requirementIds"],
        "properties": {
          "documentId": { "$ref": "#/$defs/id" },
          "requirementIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "caseIds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "description": { "$ref": "#/$defs/nonEmpty" },
          "caseIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "status", "evidence"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "$ref": "#/$defs/nonEmpty" },
          "status": { "enum": ["pass", "fail", "blocked", "skipped"] },
          "evidence": { "type": "array", "items": { "$ref": "#/$defs/repoPath" } },
          "note": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:/|~|[A-Za-z]:[\\\\/])|(?:^|/)\\.\\.(?:/|$)" }
    }
  }
}
